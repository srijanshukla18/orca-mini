# Maintainer-only Apple release credentials. Local builds do not need this file.
TEAM_ID="<apple_developer_team_id>"
APP_SPECIFIC_PASSWORD_KEYCHAIN="<notarytool_keychain_profile>"
SIGNING_IDENTITY="Developer ID Application: <name> (<team_id>)"
DEVELOPER_ID_PROFILE="<developer_id_provisioning_profile_name>"

# Optional; defaults to the canonical Orca Mini repository.
ORCA_GITHUB_REPOSITORY="srijanshukla18/orca-mini"
